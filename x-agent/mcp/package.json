{
  "name": "x-agent-mcp",
  "version": "0.2.1",
  "private": true,
  "type": "module",
  "description": "Local MCP server for the x-agent Claude Code plugin.",
  "engines": {
    "node": ">=20"
  },
  "main": "dist/mcp/src/server.js",
  "bin": {
    "x-agent-mcp": "dist/mcp/src/server.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "list-tools": "tsx ../tests/list-tools.ts",
    "start": "tsx src/server.ts",
    "prepare": "tsc -p tsconfig.build.json"
  },
  "dependencies": {
    "@google/genai": "^2.10.0",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "adm-zip": "^0.5.16",
    "playwright": "^1.56.0",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0",
    "vitest": "^2.1.0"
  }
}
