                                        "url": "http://127.0.0.1:9400/wp-content/uploads/2026/08/x-pixel-d9a441.gif",
                                        "alt": "The Moulin Rouge windmill glowing at dusk",
                                        "width": "100%",
                                        "aspectRatio": "3/4",
                                        "scale": "cover",
                                        "metadata": { "imageIntent": "Belle Époque poster-style illustration of the red windmill at dusk: gaslights along Boulevard de Clichy, warm gold sky behind deep red sails, crowds in top hats and gowns below." }
                                    }
                                }
                            ]
                        }
                    ]
                }
            ]
