                                    },
                                    "innerBlocks": [
                                        { "name": "core/heading", "attributes": { "level": 3, "content": "Champagne by the quarter-million", "fontSize": "large", "fontFamily": "boulevard", "textColor": "gold" } },
                                        { "name": "core/paragraph", "attributes": { "content": "The house claims the world record for champagne: around 240,000 bottles are uncorked every year between the evening’s two shows.", "fontSize": "medium" } }
